    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# source - Texas one year estimate jobs by specialization\n",
        "# https://data.census.gov/table/ACSDT1Y2023.B15012?q=texas+education+degrees+in+2023\n",
        "\n",
        "\n",
        "data = requests.get('https://api.census.gov/data/2023/acs/acs1?get=group(B15012)&ucgid=0400000US48').json()\n",
        "\n",
        "variables= ['B15012_002E','B15012_003E','B15012_004E','B15012_005E','B15012_006E','B15012_007E','B15012_008E','B15012_009E', 'B15012_010E','B15012_011E','B15012_012E','B15012_013E','B15012_014E','B15012_015E','B15012_016E']\n",
        "\n",
        "labels= ['Computers, Mathematics, and Statistics','Bilogical, Agricultural, and Environmental Sciences','Physical and Related Sciences','Psychology',\n",
        "         'Social Sciences','Engineering','Multidisciplinary Studies','Science and Engineering Related Fields','Business','Education',\n",
        "         'Literature and Languages','Liberal Arts and History','Visual and Performing Arts','Communications','Other']\n",
        "\n",
        "# B15012_002E: Science and Engineering- Computers, Mathematics, and Statistics\n",
        "# B15012_003E: Science and Engineering- Bilogical, Agricultural, and Environmental Sciences\n",
        "# B15012_004E: Science and Engineering- Physical and Related Sciences\n",
        "# B15012_005E: Science and Engineering- Psychology\n",
        "# B15012_006E: Science and Engineering- Social Sciences\n",
        "# B15012_007E: Science and Engineering- Engineering\n",
        "# B15012_008E: Science and Engineering- Multidisciplinary Studies\n",
        "# B15012_009E: Science and Engineering- Science and Engineering Related Fields\n",
        "# B15012_010E: Science and Engineering- Business\n",
        "# B15012_011E: Science and Engineering- Education\n",
        "# B15012_012E: Arts, Humanities, and Other- Literature and Languages\n",
        "# B15012_013E: Arts, Humanities, and Other- Liberal Arts and History\n",
        "# B15012_014E: Arts, Humanities, and Other- Visual and Performing Arts\n",
        "# B15012_015E: Arts, Humanities, and Other- Communications\n",
        "# B15012_016E: Arts, Humanities, and Other- Other\n",
        "\n",
        "# Created a dataframe with the data from the API\n",
        "df2 = pd.DataFrame(data)\n",
        "# Changed column names\n",
        "df2.columns= df2.iloc[0]\n",
        "# Dropped the first row of the dataframe\n",
        "df2 = df2.drop(df2.index[0])\n",
        "\n",
        "# filtered the dataframe to only include the columns I need\n",
        "df2 = df2[['B15012_002E','B15012_003E','B15012_004E','B15012_005E','B15012_006E','B15012_007E','B15012_008E','B15012_009E', 'B15012_010E','B15012_011E','B15012_012E','B15012_013E','B15012_014E','B15012_015E','B15012_016E']]\n",
        "\n",
        "for index, value in enumerate(df2.columns):\n",
        "  df2 = df2.rename(columns={df2.columns[index]: labels[index]})\n",
        "\n",
        "df2.reset_index(drop=True, inplace=True)\n",
        "df2 = df2.melt()\n",
        "\n",
        "df2 = df2.rename(columns={0: 'Specialization', 'value':'Total Estimated'}).sort_values(by='Total Estimated', ascending=False).reset_index(drop=True)\n",
        "\n",
        "df2"
      ],
      "id": "765fe4d3",
      "execution_count": null,
      "outputs": []
    },
