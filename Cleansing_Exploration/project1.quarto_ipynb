    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Install dependencies as needed:\n",
        "# pip install kagglehub[pandas-datasets]\n",
        "import requests, csv\n",
        "from bs4 import BeautifulSoup\n",
        "from selenium import webdriver\n",
        "from selenium.webdriver.common.keys import Keys\n",
        "from selenium.webdriver.common.by import By\n",
        "import kaggle\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from lets_plot import *\n",
        "import textwrap\n",
        "from selenium.webdriver.support.ui import WebDriverWait\n",
        "from selenium.webdriver.support import expected_conditions as EC\n",
        "\n",
        "LetsPlot.setup_html(isolated_frame=True)"
      ],
      "id": "9f0312a5",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Authenticating my API\n",
        "kaggle.api.authenticate()\n",
        "kaggle.api.dataset_download_files('hummaamqaasim/jobs-in-data', path='.', unzip=True)\n",
        "\n",
        "# download the csv dataset into dataframe\n",
        "df = pd.read_csv('cleansing_exploration_datasets/jobs_in_data.csv')\n",
        "\n",
        "# check for missing values\n",
        "df.isna().sum()\n",
        "\n",
        "# check datatypes of each column\n",
        "df.dtypes\n",
        "\n",
        "# filter dataset for only US based companies and employees that have a residence in the US\n",
        "df = df[(df['employee_residence'].isin(['United States'])) & df['company_location'].isin(['United States'])]\n",
        "\n",
        "# see what years this dataset covers\n",
        "df['job_category'].unique()"
      ],
      "id": "10ba24b6",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Filtering the dataset to only include the year 2023\n",
        "df1 = df.loc[(df['work_year'] == 2023)].reset_index(drop=True)\n",
        "# I group by job category and the mean salary in USD\n",
        "df1 = round(df1.groupby('job_category').agg(\n",
        "      avg_salary=('salary_in_usd', 'mean'),\n",
        "      job_count=('job_category', 'count')\n",
        "    ).reset_index(),2)\n",
        "\n",
        "# Here I create my line graph to see salaries for each job title in the US\n",
        "(\n",
        "  ggplot(df1, aes(x = 'avg_salary', y = 'job_category', fill='job_category'))\n",
        "  # Here I create line and give it a size\n",
        "  + geom_bar(size = 1.5, stat='identity', show_legend= False)\n",
        "  # Here I have the different colors for each line\n",
        "  + scale_color_manual(values=['#66FF03','#ff000d','#ffff00', '#0099ff', '#f58231',\n",
        "                                '#911eb4', '#fabed4', '#f032e6', '#dcbeff', '#800000'])\n",
        "  # Here I change the scale intervals in the x-axis and y-axis and format the x-axis years to not show a comma\n",
        "  + scale_x_continuous(format= ',d', breaks=np.arange(0, 250000, step=50000))\n",
        "  # + scale_y_continuous(breaks=np.arange(95000, 200000, step=50000))\n",
        "  # Here I cut off any part of the graph I do not need\n",
        "  # + coord_cartesian(xlim=(1920, 2000), ylim=(0, 55000))\n",
        "  + theme(\n",
        "        # change the complete background to black\n",
        "        plot_background=element_rect(fill='#36454F'),\n",
        "        # changing the grid color lines to shade of white. Also changed size of the grid lines\n",
        "        panel_grid=element_line(color='#E2DFD2', size=1),\n",
        "        # this is how I changed the y-axis and x-axis numbers labels to white, as well as their respective titles\n",
        "        axis_text = element_text(color='white'),\n",
        "        # axis_title = element_text(color='white'),\n",
        "        # this is how I made the title and subtitle white\n",
        "        title = element_text(color='white'),\n",
        "        # Here I make the y-axis labels smaller\n",
        "        axis_text_y=element_text(size=9),\n",
        "        # Here I make the x-axis labels smaller\n",
        "        axis_text_x=element_text(size=10),\n",
        "        # Here I change the position of the title and subtitle to be on the left side of the plot\n",
        "        plot_title_position='plot',\n",
        "        # Here I add a margin around the entire plot\n",
        "        plot_margin = 25,\n",
        "        axis_title=element_text(size=13)\n",
        "      )\n",
        "  # Here I add the title, subtitle, x-axis and y-axis titles\n",
        "  + labs(\n",
        "        title = 'Salaries for Each Job Title in the US',\n",
        "        subtitle = '2023 Results',\n",
        "        x = 'Average Salary in USD',\n",
        "        y = 'Job Category' \n",
        "        )\n",
        ")"
      ],
      "id": "40fb601a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Here I create my line graph to see salaries for each job title in the US\n",
        "(\n",
        "  ggplot(df1, aes(x = 'job_category', y = 'job_count', fill='job_category'))\n",
        "  # Here I create line and give it a size\n",
        "  + geom_bar(size = 1.5, stat='identity', show_legend= True)\n",
        "  # Here I have the different colors for each line\n",
        "  + scale_color_manual(values=['#66FF03','#ff000d','#ffff00', '#0099ff', '#f58231',\n",
        "                                '#911eb4', '#fabed4', '#f032e6', '#dcbeff', '#800000'])\n",
        "  # Here I change the scale intervals in the x-axis and y-axis and format the x-axis years to not show a comma\n",
        "  # + scale_x_continuous(format= ',d', breaks=np.arange(0, 250000, step=50000))\n",
        "  + scale_y_continuous(breaks=np.arange(0, 2400, step=200))\n",
        "  # Here I cut off any part of the graph I do not need\n",
        "  # + coord_cartesian(xlim=(1920, 2000), ylim=(0, 55000))\n",
        "  + theme(\n",
        "        # change the complete background to black\n",
        "        plot_background=element_rect(fill='#36454F'),\n",
        "        # changing the grid color lines to shade of white. Also changed size of the grid lines\n",
        "        panel_grid=element_line(color='#E2DFD2', size=1),\n",
        "        # this is how I changed the y-axis and x-axis numbers labels to white, as well as their respective titles\n",
        "        axis_text = element_text(color='white'),\n",
        "        # axis_title = element_text(color='white'),\n",
        "        # this is how I made the title and subtitle white\n",
        "        title = element_text(color='white'),\n",
        "        # Here I make the y-axis labels smaller\n",
        "        axis_text_y=element_text(size=9),\n",
        "        # Here I make the x-axis labels smaller\n",
        "        axis_text_x=element_text(size=0),\n",
        "        # Here I change the position of the title and subtitle to be on the left side of the plot\n",
        "        plot_title_position='panel',\n",
        "        # Here I add a margin around the entire plot\n",
        "        plot_margin = 25,\n",
        "        # Here I change the size of the titles in the axes\n",
        "        axis_title=element_text(size=13),\n",
        "        # here I change the background of the legend\n",
        "        legend_background=element_rect('#36454F'),\n",
        "        # Here I change the legend key text to white and the size of text\n",
        "        legend_text=element_text(size=10, color='white')\n",
        "      )\n",
        "  # Here I add the title, subtitle, x-axis and y-axis titles\n",
        "  + labs(\n",
        "        title = 'Job Count for Each Job Title',\n",
        "        subtitle = '2023 US Results',\n",
        "        x = '',\n",
        "        y = 'Job Count',\n",
        "        fill='Job Category'\n",
        "        )\n",
        ")"
      ],
      "id": "f253ab60",
      "execution_count": null,
      "outputs": []
    },
