    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Employment data for Texas\n",
        "# https://data.bls.gov/oes/#/area/4800000\n",
        "\n",
        "#Selenium link\n",
        "# https://builtin.com/articles/selenium-web-scraping\n",
        "\n",
        "cService = webdriver.ChromeService(executable_path='C:/Users/lrive/Downloads/chromedriver-win64/chromedriver-win64/chromedriver.exe')\n",
        "driver = webdriver.Chrome(service=cService)\n",
        "\n",
        "driver.get('https://data.bls.gov/oes/#/area/4800000')\n",
        "\n",
        "# Wait for the table body to be present (I adjust the time in seconds as needed)\n",
        "WebDriverWait(driver, 20).until(\n",
        "    EC.presence_of_element_located((By.XPATH, '//*[@id=\"oes-container\"]/div/div/div[2]/div/div[2]/div/table/tbody/tr[1]'))\n",
        ")\n",
        "\n",
        "table_body = driver.find_element(By.XPATH, '//*[@id=\"oes-container\"]/div/div/div[2]/div/div[2]/div/table/tbody')\n",
        "table_rows = table_body.find_elements(By.TAG_NAME, 'tr')\n",
        "\n",
        "headers_list = []\n",
        "rows_list = []\n",
        "for item in driver.find_elements(By.XPATH, '//*[@id=\"oes-container\"]/div/div/div[2]/div/div[2]/div/table/tbody/tr'):\n",
        "  if item.text != '':\n",
        "    # first I split the text with comma as the delimiter wherever a new line occurs (this happens once every row)\n",
        "    row = item.text.split('\\n')\n",
        "    # Here I append the first string value in the row to the list\n",
        "    rows_list.append(row[0])\n",
        "    # Here I replace any dash in the second string with a space\n",
        "    row[1] = row[1].translate(str.maketrans({'-': ' '}))\n",
        "    # Here I split the second string with a comma wherever a space occurs - these strings are in their own list (list within a list)\n",
        "    row[1] = row[1].split(' ')\n",
        "    # I append the items in the nested list to the rows_list variable\n",
        "    for value in row[1]:\n",
        "      rows_list.append(value)\n",
        "    # if len(item.text) > 0:\n",
        "      # rows_list.append(item.text)\n",
        "      # rows_list.append(individual_item)\n",
        "# driver.quit()\n",
        "\n",
        "# I now use list comprehension to remove any empty strings in the list\n",
        "new_rows_list = [non_blank_value for non_blank_value in rows_list if non_blank_value != '']\n",
        "\n",
        "for item in driver.find_elements(By.XPATH, '//*[@id=\"oes-container\"]/div/div/div[2]/div/div[2]/div/table/thead/tr/th'):\n",
        "  if item.text != '':\n",
        "    headers_list.append(item.text)\n",
        "    \n",
        "driver.quit()"
      ],
      "id": "8a70cace",
      "execution_count": null,
      "outputs": []
    },
